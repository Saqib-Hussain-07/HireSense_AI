# Server
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# Auth
JWT_SECRET=change_this_to_a_long_random_string
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=your_google_oauth_client_id

# Database
MONGO_URI=mongodb://127.0.0.1:27017/hiresense
# If you don't have Mongo running locally or Atlas set up yet, the server
# will still boot using an in-memory fallback store (see src/config/db.js)
# so you can develop the API without a real database.

# AI Reasoning provider (primary)
AI_PRIMARY_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key
OPENAI_API_KEY=your_openai_api_key

# AI Reasoning provider (fallback, fast, triggered on primary error/timeout)
AI_FALLBACK_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key

# Speech-to-Text fallback (browser Web Speech API is the primary, used client-side)
WHISPER_API_KEY=your_whisper_capable_api_key

# Text-to-Speech
ELEVENLABS_API_KEY=your_elevenlabs_api_key
ELEVENLABS_VOICE_ID=default_voice_id
# TTS fallback is the browser's built-in SpeechSynthesis API (client-side, no key needed)

# File storage
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_key
CLOUDINARY_API_SECRET=your_cloudinary_secret
# If Cloudinary isn't configured, resumes are stored to backend/uploads instead.
