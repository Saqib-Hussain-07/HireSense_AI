# ─── Docker ignore for backend ───────────────────────────────────────────────
# Keeps the Docker image lean — only production code is copied.

node_modules/
npm-debug.log*
.env
.env.*
!.env.example

# Test files — not needed at runtime
tests/
coverage/
*.test.js

# Diagnostic / operational scripts
scripts/

# Uploads directory — volume-mounted in production, not baked in
uploads/*
!uploads/.gitkeep

# Editor and OS
.DS_Store
.vscode/
.idea/
*.swp

# Git
.git/
.gitignore
