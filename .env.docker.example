# ─── HireSense AI — Docker Compose Environment Variables ─────────────
# Copy this file to .env before running `docker compose up`
#
# cp .env.docker.example .env
# ─────────────────────────────────────────────────────────────────────

# Server Configuration
PORT=5000
CLIENT_ORIGIN=http://localhost:3000

# Authentication
JWT_SECRET=change_this_to_a_secure_random_string_in_production
JWT_EXPIRES_IN=7d
GOOGLE_CLIENT_ID=

# Database (Internal Docker Compose DNS points to the mongodb container)
MONGO_URI=mongodb://mongodb:27017/hiresense

# AI Reasoning Providers
AI_PRIMARY_PROVIDER=gemini
GEMINI_API_KEY=
OPENAI_API_KEY=

# AI Fallback Provider (Groq for ultra-fast fallback)
AI_FALLBACK_PROVIDER=groq
GROQ_API_KEY=

# Speech-to-Text (Whisper fallback)
WHISPER_API_KEY=

# Text-to-Speech (ElevenLabs)
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Cloudinary Storage (Optional — uploads default to local backend/uploads volume)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
