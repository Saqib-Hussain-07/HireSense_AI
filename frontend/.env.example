# ─── HireSense AI — Frontend environment variables ───────────────────────────
# Copy this file to .env.local (never commit .env.local to git).
#
# In development, the Vite proxy (vite.config.js) forwards /api and /ws to
# http://localhost:5000, so VITE_API_URL is NOT needed in dev mode.
#
# In production, set VITE_API_URL to the deployed backend URL.
# ─────────────────────────────────────────────────────────────────────────────

# Backend API URL (only needed for production builds)
VITE_API_URL=http://localhost:5000

